{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEKOPLAY",
  "version": "0.1.0",
  "identifier": "com.nekoplay.player",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NEKOPLAY",
        "width": 1200,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required",
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "copyright": "© 2026 NEKOPLAY",
    "category": "Music",
    "shortDescription": "NEKOPLAY 本地音乐播放器",
    "longDescription": "BenchLab 风格的本地音乐播放器：队列、歌词、真实频谱与内嵌封面。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
